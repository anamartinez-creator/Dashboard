# Token of the Notion integration that has access to the Master SDM Tracker page
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxx
# Password people type to open the dashboard (any username works)
DASHBOARD_PASSWORD=change-me
# Optional: verification token of the Notion webhook (instant updates)
NOTION_WEBHOOK_SECRET=
# Talent Acquisition: JSON of the Google service account (read-only) that can see the sheets
GOOGLE_SERVICE_ACCOUNT_JSON=
# Talent Acquisition: ID of the "Active Job Openings" sheet
HIRING_SHEET_ID=
# Optional: ID of the "Bonuses - Hires and Referrals" sheet (has a default)
BONUSES_SHEET_ID=
# Optional: read-only Ashby key (Candidates and Jobs) for the stages in Active roles
ASHBY_API_KEY=
